CART:
- ng g module cart  
- ng g service cart/cart
- ng g c cart/cart-view

mat-list:
- listing cart times

snack-bar:
    - for popup
    addToCart(product:Product):void{
        this.cartService.addToCart(product).subscribe({
        //when the addtocart got sent and returned successfull next...
        next: () =>{
            this.snackBar.open("Product added to Cart!","",{
            duration: 2000,
            horizontalPosition: 'right',
            verticalPosition: 'top'
            })
        }
        });
    }

Filter functionality:
    - filter the items depening on the input
    - oninit it contains all items since no filter is applied
    - using MatInputModule for html functionality
        -dynamic , applied when we stop writing on input(keyup) , filters dynamically
        <mat-form-field>
            <input matInput (keyup)="applyFilter($event)" placeholder="Search">
        </mat-form-field>

    applyFilter(event:Event): void{
        let searchTerm = (event.target as HTMLInputElement).value;
        searchTerm = searchTerm.toLowerCase();
        this.filteredProducts = this.products.filter(
            product => product.name.toLowerCase().includes(searchTerm)
        )
    }

Sort functionality:
    - uses MatSelectModule
    <mat-select (selectionChange)="sortProducts($event.value)">
        <mat-option value="priceLowHigh">Price: Low to High</mat-option>
        <mat-option value="priceHighLow">Price: High to Low</mat-option>
    </mat-select>

    sortProducts(sortValue:string): void{
        this.sortOrder = sortValue;
        if(this.sortOrder == "priceLowHigh"){
            this.filteredProducts.sort((a,b) => a.price - b.price)
        }else if(this.sortOrder == "priceHighLow"){
            this.filteredProducts.sort((a,b) => b.price - a.price) 
        }
    }